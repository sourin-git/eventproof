<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventproof.controller.DashboardController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="30" styleClass="page-content">
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT">
                    <Label text="OVERVIEW" styleClass="eyebrow" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="REVIEW 1" styleClass="review-badge" />
                </HBox>
                <Label text="Dashboard" styleClass="page-title" />
                <Label text="A workspace for exploring reliability in ordered event flows."
                       styleClass="page-subtitle" />
            </VBox>

            <HBox spacing="16">
                <VBox spacing="12" prefWidth="260" maxWidth="Infinity"
                      HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="Projects" styleClass="card-title" />
                    <Label text="Organize event flows into focused project workspaces."
                           wrapText="true" styleClass="card-description" />
                </VBox>
                <VBox spacing="12" prefWidth="260" maxWidth="Infinity"
                      HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="Events" styleClass="card-title" />
                    <Label text="Define the original sequence and sample event payloads."
                           wrapText="true" styleClass="card-description" />
                </VBox>
                <VBox spacing="12" prefWidth="260" maxWidth="Infinity"
                      HBox.hgrow="ALWAYS" styleClass="summary-card">
                    <Label text="Experiments" styleClass="card-title" />
                    <Label text="Inspect timelines after normal, duplicate, or drop runs."
                           wrapText="true" styleClass="card-description" />
                </VBox>
            </HBox>

            <VBox spacing="10" styleClass="info-panel">
                <Label text="Review 1 workflow" styleClass="panel-title" />
                <Label text="Create a project, register its ordered events, then run a reliability experiment."
                       wrapText="true" styleClass="panel-description" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
