<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventproof.controller.ProjectsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="22" minWidth="0" styleClass="page-content">
            <VBox spacing="7">
                <HBox alignment="CENTER_LEFT">
                    <Label text="OPERATIONS / RESOURCES" styleClass="eyebrow" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="REVIEW 1" styleClass="context-label" />
                </HBox>
                <Label text="Projects" styleClass="page-title" />
                <Label text="Registered systems and their event flows."
                       wrapText="true" styleClass="page-subtitle" />
            </VBox>

            <VBox styleClass="panel,resource-list">
                <HBox spacing="16" alignment="CENTER_LEFT" styleClass="panel-toolbar">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Project Registry" styleClass="section-title" />
                        <Label text="System inventory" styleClass="body-muted" />
                    </VBox>
                    <Button text="New Project" disable="true" styleClass="primary-button">
                        <tooltip><Tooltip text="Project creation will be connected in a later UI step." /></tooltip>
                    </Button>
                </HBox>
                <GridPane styleClass="table-heading">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="46" />
                        <ColumnConstraints percentWidth="16" />
                        <ColumnConstraints percentWidth="22" />
                        <ColumnConstraints percentWidth="16" />
                    </columnConstraints>
                    <Label text="PROJECT" styleClass="table-column-title" />
                    <Label text="EVENTS" GridPane.columnIndex="1" styleClass="table-column-title" />
                    <Label text="CREATED" GridPane.columnIndex="2" styleClass="table-column-title" />
                    <Label text="STATUS" GridPane.columnIndex="3" styleClass="table-column-title" />
                </GridPane>
                <HBox spacing="16" alignment="CENTER_LEFT" styleClass="empty-table-row">
                    <Label text="—" styleClass="empty-row-mark" />
                    <VBox spacing="4">
                        <Label text="No project records shown" styleClass="empty-row-title" />
                        <Label text="The resource list will populate when the UI is connected."
                               wrapText="true" styleClass="body-muted" />
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="table-footer">
                    <Label text="RESOURCE LIST PREVIEW" styleClass="metadata" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="0 SHOWN" styleClass="metadata" />
                </HBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>