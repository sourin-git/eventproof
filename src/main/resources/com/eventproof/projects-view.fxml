<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventproof.controller.ProjectsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="22" minWidth="0" styleClass="page-content">
            <VBox spacing="7">
                <HBox alignment="CENTER_LEFT">
                    <Label text="OPERATIONS / RESOURCES" styleClass="eyebrow" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="REVIEW 1" styleClass="context-label" />
                </HBox>
                <Label text="Projects" styleClass="page-title" />
                <Label text="Registered systems and their ordered event flows."
                       wrapText="true" styleClass="page-subtitle" />
            </VBox>

            <HBox spacing="14" alignment="TOP_LEFT">
                <VBox spacing="0" prefWidth="390" minWidth="0" maxWidth="Infinity"
                      HBox.hgrow="ALWAYS" styleClass="panel,resource-list">
                    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="panel-toolbar">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Project Registry" styleClass="section-title" />
                            <Label fx:id="projectCountLabel" text="REGISTERED SYSTEMS" styleClass="metadata" />
                        </VBox>
                        <Button fx:id="newProjectButton" text="New Project" onAction="#showCreateProjectDialog"
                                styleClass="primary-button" />
                    </HBox>
                    <TableView fx:id="projectsTable" prefHeight="430" minHeight="330"
                               minWidth="0" VBox.vgrow="ALWAYS" styleClass="console-table">
                        <columns>
                            <TableColumn fx:id="projectNameColumn" text="PROJECT" prefWidth="145" />
                            <TableColumn fx:id="projectDescriptionColumn" text="DESCRIPTION" prefWidth="135" />
                            <TableColumn fx:id="projectCreatedColumn" text="CREATED" prefWidth="96" />
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="0" prefWidth="510" minWidth="0" maxWidth="Infinity"
                      HBox.hgrow="ALWAYS" styleClass="panel,resource-list">
                    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="panel-toolbar">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Event Flow" styleClass="section-title" />
                            <Label fx:id="selectedProjectLabel" text="SELECT A PROJECT" styleClass="metadata" />
                        </VBox>
                        <Button fx:id="addEventButton" text="Add Event" disable="true"
                                onAction="#showAddEventDialog" styleClass="secondary-button" />
                    </HBox>
                    <TableView fx:id="eventsTable" prefHeight="430" minHeight="330"
                               minWidth="0" VBox.vgrow="ALWAYS" styleClass="console-table">
                        <columns>
                            <TableColumn fx:id="sequenceColumn" text="SEQUENCE" prefWidth="80" />
                            <TableColumn fx:id="eventNameColumn" text="EVENT NAME" prefWidth="180" />
                            <TableColumn fx:id="payloadColumn" text="SAMPLE PAYLOAD" prefWidth="240" />
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
