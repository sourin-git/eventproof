<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventproof.controller.ExperimentsController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
    <content>
        <VBox spacing="22" minWidth="0" styleClass="page-content">
            <VBox spacing="7">
                <HBox alignment="CENTER_LEFT">
                    <Label text="OPERATIONS / TESTING" styleClass="eyebrow" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="REVIEW 1" styleClass="context-label" />
                </HBox>
                <Label text="Experiments" styleClass="page-title" />
                <Label text="Inject faults into registered event flows."
                       wrapText="true" styleClass="page-subtitle" />
            </VBox>

            <HBox spacing="14" alignment="TOP_LEFT">
                <VBox spacing="16" prefWidth="330" minWidth="0" maxWidth="Infinity"
                      HBox.hgrow="ALWAYS" styleClass="panel,configuration-panel">
                    <VBox spacing="4">
                        <Label text="Experiment Configuration" styleClass="section-title" />
                        <Label text="SELECT A FLOW AND FAULT" styleClass="metadata" />
                    </VBox>
                    <VBox spacing="7">
                        <Label text="PROJECT" styleClass="field-label" />
                        <ComboBox promptText="Select a project" disable="true"
                                  maxWidth="Infinity" minWidth="0" styleClass="console-combo" />
                    </VBox>
                    <VBox spacing="7">
                        <Label text="FAULT TYPE" styleClass="field-label" />
                        <ComboBox value="NORMAL" maxWidth="Infinity" minWidth="0" styleClass="console-combo">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="NORMAL" />
                                    <String fx:value="DUPLICATE" />
                                    <String fx:value="DROP" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>
                    <VBox spacing="7">
                        <Label text="TARGET EVENT" styleClass="field-label" />
                        <ComboBox promptText="Select an event" disable="true"
                                  maxWidth="Infinity" minWidth="0" styleClass="console-combo" />
                    </VBox>
                    <VBox spacing="7">
                        <Label text="EXPERIMENT NAME" styleClass="field-label" />
                        <TextField promptText="e.g. Payment retry test" disable="true"
                                   styleClass="console-input" />
                    </VBox>
                    <Button text="Run Experiment" disable="true"
                            maxWidth="Infinity" styleClass="primary-button">
                        <tooltip><Tooltip text="Experiment execution will be connected in a later UI step." /></tooltip>
                    </Button>
                    <Label text="Configuration preview only." styleClass="metadata" />
                </VBox>

                <VBox spacing="16" prefWidth="460" minWidth="0" maxWidth="Infinity"
                      HBox.hgrow="ALWAYS" styleClass="panel,result-panel">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Execution Preview / Result" styleClass="section-title" />
                            <Label text="ORDERED EVENT OCCURRENCES" styleClass="metadata" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="PREVIEW" styleClass="context-label" />
                    </HBox>
                    <VBox spacing="12" styleClass="timeline-placeholder">
                        <Label text="TIMELINE" styleClass="eyebrow" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="01" styleClass="row-index" />
                            <Label text="Event occurrences will appear here" styleClass="body-muted" />
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="02" styleClass="row-index" />
                            <Label text="Each row retains its execution order" styleClass="body-muted" />
                        </HBox>
                        <Label text="Run an experiment to inspect its result."
                               wrapText="true" styleClass="metadata" />
                    </VBox>
                    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="legend-row">
                        <Label text="FAULT KEY" styleClass="eyebrow" />
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="&#9679;" styleClass="normal-text" />
                            <Label text="NORMAL" styleClass="legend-text" />
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="&#9679;" styleClass="duplicate-text" />
                            <Label text="DUPLICATE" styleClass="legend-text" />
                        </HBox>
                        <HBox spacing="5" alignment="CENTER_LEFT">
                            <Label text="&#9679;" styleClass="drop-text" />
                            <Label text="DROP" styleClass="legend-text" />
                        </HBox>
                    </HBox>
                    <Label text="Duplicate events appear twice. Dropped events are omitted from the timeline."
                           wrapText="true" styleClass="body-muted" />
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>