<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventproof.controller.MainController" styleClass="app-shell">
    <left>
        <VBox prefWidth="208" minWidth="208" maxWidth="208" styleClass="sidebar">
            <VBox spacing="5" styleClass="brand-block">
                <Label text="EVENTPROOF" styleClass="brand-title" />
                <Label text="Reliability Lab" styleClass="brand-subtitle" />
            </VBox>

            <Label text="WORKSPACE" styleClass="sidebar-section-label" />
            <Button fx:id="dashboardButton" text="Dashboard" onAction="#showDashboard"
                    maxWidth="Infinity" styleClass="sidebar-button">
                <graphic><SVGPath content="M 1 1 H 7 V 7 H 1 Z M 11 1 H 17 V 7 H 11 Z M 1 11 H 7 V 17 H 1 Z M 11 11 H 17 V 17 H 11 Z" styleClass="nav-icon" /></graphic>
            </Button>
            <Button fx:id="projectsButton" text="Projects" onAction="#showProjects"
                    maxWidth="Infinity" styleClass="sidebar-button">
                <graphic><SVGPath content="M 1 5 V 2 H 7 L 10 5 H 18 V 16 H 1 Z" styleClass="nav-icon" /></graphic>
            </Button>
            <Button fx:id="experimentsButton" text="Experiments" onAction="#showExperiments"
                    maxWidth="Infinity" styleClass="sidebar-button">
                <graphic><SVGPath content="M 6 1 H 12 M 7 1 V 7 L 1 16 Q 0 18 3 18 H 15 Q 18 18 17 16 L 11 7 V 1 M 4 12 H 14" styleClass="nav-icon" /></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="7" styleClass="sidebar-footer">
                <Label text="REVIEW 1" styleClass="sidebar-footer-title" />
                <Label text="JAVA / JDBC / POSTGRESQL" styleClass="sidebar-tech" />
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentContainer" minWidth="0" styleClass="content-area" />
    </center>
</BorderPane>