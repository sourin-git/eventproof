<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eventproof.controller.MainController"
            styleClass="app-shell">
    <left>
        <VBox prefWidth="224" minWidth="224" maxWidth="224" styleClass="sidebar">
            <VBox spacing="4" styleClass="brand-block">
                <Label text="EventProof" styleClass="brand-title" />
                <Label text="RELIABILITY TESTING" styleClass="brand-subtitle" />
            </VBox>

            <Label text="WORKSPACE" styleClass="sidebar-section-label" />
            <Button fx:id="dashboardButton" text="Dashboard" onAction="#showDashboard"
                    maxWidth="Infinity" styleClass="sidebar-button" />
            <Button fx:id="projectsButton" text="Projects" onAction="#showProjects"
                    maxWidth="Infinity" styleClass="sidebar-button" />
            <Button fx:id="experimentsButton" text="Experiments" onAction="#showExperiments"
                    maxWidth="Infinity" styleClass="sidebar-button" />

            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="4" styleClass="sidebar-footer">
                <Label text="EVENTPROOF" styleClass="sidebar-footer-title" />
                <Label text="Review 1 workspace" styleClass="sidebar-footer-subtitle" />
            </VBox>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentContainer" styleClass="content-area" />
    </center>
</BorderPane>
